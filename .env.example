# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
POSTGRES_DB=churn_db
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://churn_user:change_me_in_production@localhost:5432/churn_db

# For local dev without Postgres, the ETL pipeline defaults to SQLite:
# DATABASE_URL=sqlite:///database/churn.db

# --- ETL paths (defaults shown) ---
RAW_DATA_PATH=data/raw/telecom_customers_raw.csv
CLEANED_DATA_PATH=data/cleaned/telecom_customers_cleaned.csv

# --- API ---
PORT=5000
FLASK_DEBUG=false
MODEL_DIR=models
SEGMENTED_DATA_PATH=data/processed/telecom_customers_segmented.csv
